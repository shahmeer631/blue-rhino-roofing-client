# Canonical site URL for SEO (canonical tags, JSON-LD, sitemap). No trailing slash.
# Vercel production: https://www.bluerhinoroofing.net or your deployment URL
# VITE_SITE_URL=https://www.bluerhinoroofing.net

# Optional: Railway (or other) API origin for production builds. No trailing slash.
# Vercel: Project → Settings → Environment Variables → VITE_API_URL = https://YOUR-SERVICE.up.railway.app
# Local: leave unset; Vite proxies /api to http://localhost:5000 (see vite.config.js).
# VITE_API_URL=
